#define BUFFER_H

#include "page.h"
#include &lt;stdio.h&gt;
#include &lt;stdbool.h&gt;

#define POOL_SIZE 10 // The number of pages we keep in RAM at once

// A Frame wraps a Page with metadata for the caching system
typedef struct {
    Page page;            // The actual 4KB block
    uint32_t page_id;     // Which disk page is currently in this frame? (-=
1 if empty)
    bool is_dirty;        // Has this page been modified since reading from=
 disk?
    int pin_count;        // How many threads are currently using this page=
? (0 means it can be evicted)
    uint64_t last_used;   // Timestamp for the LRU (Least Recently Used) ev=
iction policy
} Frame;

typedef struct {
    Frame frames[POOL_SIZE];  // The actual cache in RAM
    FILE *disk_file;          // The file we are reading/writing pages from
    uint64_t current_time;    // Simulated clock to track LRU
} BufferPool;

// Buffer Pool Functions
void init_buffer_pool(BufferPool *pool, const char *db_filename);
Page* fetch_page(BufferPool *pool, uint32_t page_id);
void unpin_page(BufferPool *pool, uint32_t page_id, bool is_dirty);
bool flush_page(BufferPool *pool, uint32_t page_id);
void flush_all_pages(BufferPool *pool);

#endif</code></pre></div>
<h3 style=3D"font-size: var(--text-md); font-weight: 600; margin: 12px 0px =
6px;">The Functions Explained:</h3>
<ol style=3D"margin: 0px 0px 8px; padding-left: 20px; display: flex; flex-d=
irection: column; gap: 3px;">
<li style=3D"line-height: 1.6;"><strong style=3D"font-weight: 600; color: v=
ar(--text-primary);"><code class=3D"mono" style=3D"background: var(--bg-rai=
sed); border: 1px solid var(--border-subtle); border-radius: 4px; padding: =
1px 5px; font-size: var(--text-sm); color: var(--text-primary);">fetch_page=
(page_id)</code></strong>: This is the most important function. It loops th=
rough the <code class=3D"mono" style=3D"background: var(--bg-raised); borde=
r: 1px solid var(--border-subtle); border-radius: 4px; padding: 1px 5px; fo=
nt-size: var(--text-sm); color: var(--text-primary);">frames</code> array t=
o find the page. If it's not there, it finds a frame with <code class=3D"mo=
no" style=3D"background: var(--bg-raised); border: 1px solid var(--border-s=
ubtle); border-radius: 4px; padding: 1px 5px; font-size: var(--text-sm); co=
lor: var(--text-primary);">pin_count =3D=3D 0</code> (using LRU if multiple=
 are available), evicts whatever is there (flushing to disk if <code class=
=3D"mono" style=3D"background: var(--bg-raised); border: 1px solid var(--bo=
rder-subtle); border-radius: 4px; padding: 1px 5px; font-size: var(--text-s=
m); color: var(--text-primary);">is_dirty</code>), reads the new 4KB page f=
rom the file, increments <code class=3D"mono" style=3D"background: var(--bg=
-raised); border: 1px solid var(--border-subtle); border-radius: 4px; paddi=
ng: 1px 5px; font-size: var(--text-sm); color: var(--text-primary);">pin_co=
unt</code>, and returns a pointer to the <code class=3D"mono" style=3D"back=
ground: var(--bg-raised); border: 1px solid var(--border-subtle); border-ra=
dius: 4px; padding: 1px 5px; font-size: var(--text-sm); color: var(--text-p=
rimary);">Page</code>.</li>
<li style=3D"line-height: 1.6;"><strong style=3D"font-weight: 600; color: v=
ar(--text-primary);"><code class=3D"mono" style=3D"background: var(--bg-rai=
sed); border: 1px solid var(--border-subtle); border-radius: 4px; padding: =
1px 5px; font-size: var(--text-sm); color: var(--text-primary);">unpin_page=
(page_id, is_dirty)</code></strong>: When the executor finishes inserting o=
r reading a tuple, it calls this to say "I am done using this page". It dec=
rements the <code class=3D"mono" style=3D"background: var(--bg-raised); bor=
der: 1px solid var(--border-subtle); border-radius: 4px; padding: 1px 5px; =
font-size: var(--text-sm); color: var(--text-primary);">pin_count</code> so=
 the page becomes eligible for eviction. If it inserted a tuple, it passes =
<code class=3D"mono" style=3D"background: var(--bg-raised); border: 1px sol=
id var(--border-subtle); border-radius: 4px; padding: 1px 5px; font-size: v=
ar(--text-sm); color: var(--text-primary);">is_dirty =3D true</code>.</li>
<li style=3D"line-height: 1.6;"><strong style=3D"font-weight: 600; color: v=
ar(--text-primary);"><code class=3D"mono" style=3D"background: var(--bg-rai=
sed); border: 1px solid var(--border-subtle); border-radius: 4px; padding: =
1px 5px; font-size: var(--text-sm); color: var(--text-primary);">flush_page=
(page_id)</code></strong>: Forces a specific dirty page back to the hard dr=
ive immediately (useful for saving data permanently).</li>
</ol>
