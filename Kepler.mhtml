"8" rx=3D"2" ry=3D"2"></rect><path d=3D"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2=
-2h10c1.1 0 2 .9 2 2"></path></svg></button></div><pre class=3D"mono kepler=
-code-block__pre" style=3D"margin: 0px; padding: 8px 12px; font-size: var(-=
-text-sm); line-height: 1.55; color: var(--text-primary); background: var(-=
-bg-base); overflow: auto; max-width: 100%;"><code>#include &lt;stdint.h&gt=
;
#include &lt;stdbool.h&gt;

#define PAGE_SIZE 4096

// A single slot tracking where a record lives in this page
typedef struct {
    uint16_t offset;  // Where does the tuple start in the 4KB array?
    uint16_t length;  // How many bytes is the tuple?
} Slot;

// The metadata at the front of the 4KB block
typedef struct {
    uint32_t page_id;       // Which page is this?
    uint16_t free_space;    // Offset to the start of the unallocated space=
 (grows backwards)
    uint16_t slot_count;    // Number of slots currently in the array
    // Later for transactions: uint32_t lsn (Log Sequence Number)
} PageHeader;

// The actual Page in memory
typedef struct {
    char data[PAGE_SIZE];   // The raw 4KB buffer
} Page;</code></pre></div>
