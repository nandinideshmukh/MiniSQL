und: var(--bg-raised); border: 1px solid var(--border-subtle); border-radiu=
s: 4px; padding: 1px 5px; font-size: var(--text-sm); color: var(--text-prim=
ary);">delete from cars where age =3D 24</code></li>
</ul>
<hr style=3D"border-top: 1px solid var(--border-subtle); border-right-width=
