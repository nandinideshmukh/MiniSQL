-2h10c1.1 0 2 .9 2 2"></path></svg></button></div><pre class=3D"mono kepler=
-code-block__pre" style=3D"margin: 0px; padding: 8px 12px; font-size: var(-=
-text-sm); line-height: 1.55; color: var(--text-primary); background: var(-=
-bg-base); overflow: auto; max-width: 100%;"><code>#ifndef PAGE_H
#define PAGE_H

#include &lt;stdint.h&gt;
#include &lt;stdbool.h&gt;

#define PAGE_SIZE 4096

// A slot pointing to where the tuple lives in the page
typedef struct {
    uint16_t offset;
    uint16_t length;
} Slot;

// The header placed at the very beginning of the 4KB page
typedef struct {
    uint32_t page_id;       // Which page is this?
    uint16_t free_space;    // Offset where free space ENDS (tuples grow ba=
ckwards from here)
    uint16_t slot_count;    // Number of slots currently in use
} PageHeader;

// The raw 4KB memory block
typedef struct {
    char data[PAGE_SIZE];
} Page;

// Core Slotted Page Functions
void init_page(Page *page, uint32_t page_id);
int insert_tuple(Page *page, const char *record_data, uint16_t record_len);
bool get_tuple(Page *page, int slot_id, char *out_buffer);
bool delete_tuple(Page *page, int slot_id);

#endif</code></pre></div>
<h3 style=3D"font-size: var(--text-md); font-weight: 600; margin: 12px 0px =
6px;">2. <code class=3D"mono" style=3D"background: var(--bg-raised); border=
: 1px solid var(--border-subtle); border-radius: 4px; padding: 1px 5px; fon=
t-size: var(--text-sm); color: var(--text-primary);">cfiles/src/page/page.c=
</code></h3>
<p style=3D"margin: 0px 0px 8px; line-height: 1.65;">This handles the point=
er math to manage the layout. The slots grow forward from the header, and t=
he tuple strings grow backwards from the end of the 4096 bytes.</p>
<div class=3D"kepler-code-block"><div class=3D"kepler-code-block__toolbar">=
<span class=3D"kepler-code-block__lang mono">c</span><button type=3D"button=
" class=3D"kepler-code-block__copy" aria-label=3D"Copy code" title=3D"Copy =
code"><svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"13" height=3D"13" =
viewBox=3D"0 0 24 24" fill=3D"none" stroke=3D"currentColor" stroke-width=3D=
"2" stroke-linecap=3D"round" stroke-linejoin=3D"round" class=3D"lucide luci=
de-copy" aria-hidden=3D"true"><rect width=3D"14" height=3D"14" x=3D"8" y=3D=
"8" rx=3D"2" ry=3D"2"></rect><path d=3D"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2=
-2h10c1.1 0 2 .9 2 2"></path></svg></button></div><pre class=3D"mono kepler=
-code-block__pre" style=3D"margin: 0px; padding: 8px 12px; font-size: var(-=
-text-sm); line-height: 1.55; color: var(--text-primary); background: var(-=
-bg-base); overflow: auto; max-width: 100%;"><code>#include "page.h"
#include &lt;string.h&gt;

// Initializes a 4KB block as an empty Slotted Page
void init_page(Page *page, uint32_t page_id) {
    memset(page-&gt;data, 0, PAGE_SIZE); // Zero out the 4KB
   =20
    // The header lives at the very front (byte 0)
    PageHeader *header =3D (PageHeader *)page-&gt;data;
    header-&gt;page_id =3D page_id;
    header-&gt;free_space =3D PAGE_SIZE; // Free space ends at the very bac=
k of the 4KB block
    header-&gt;slot_count =3D 0;
}

// Inserts a tuple and returns its Slot ID
int insert_tuple(Page *page, const char *record_data, uint16_t record_len) =
{
    PageHeader *header =3D (PageHeader *)page-&gt;data;
   =20
    // We need space for the new data AND the new slot metadata
    uint16_t space_needed =3D record_len + sizeof(Slot);
   =20
    // Where does the slot array currently end?
    uint16_t slot_array_end =3D sizeof(PageHeader) + (header-&gt;slot_count=
 * sizeof(Slot));
   =20
    // Check if the gap between the slots (growing forward) and tuples (gro=
wing backward) is big enough
    if (header-&gt;free_space - slot_array_end &lt; space_needed) {
        return -1; // Not enough room! Page is full.
    }
   =20
    // Tuples grow BACKWARDS, so subtract length from free_space
    uint16_t tuple_offset =3D header-&gt;free_space - record_len;
   =20
    // Copy the actual data to the back
    memcpy(page-&gt;data + tuple_offset, record_data, record_len);
   =20
    // Create the slot (immediately after the existing slots)
    Slot *slots =3D (Slot *)(page-&gt;data + sizeof(PageHeader));
    slots[header-&gt;slot_count].offset =3D tuple_offset;
    slots[header-&gt;slot_count].length =3D record_len;
   =20
    // Update the header
    header-&gt;free_space =3D tuple_offset; // Move the free space boundary
    int slot_id =3D header-&gt;slot_count;
    header-&gt;slot_count++;
   =20
    return slot_id;
}

// Reads a tuple out into a buffer
bool get_tuple(Page *page, int slot_id, char *out_buffer) {
    PageHeader *header =3D (PageHeader *)page-&gt;data;
   =20
    // Invalid slot ID
    if (slot_id &lt; 0 || slot_id &gt;=3D header-&gt;slot_count) {
        return false;
    }
   =20
    Slot *slots =3D (Slot *)(page-&gt;data + sizeof(PageHeader));
    Slot target_slot =3D slots[slot_id];
   =20
    // If length is 0, it means it's a deleted tombstone
    if (target_slot.length =3D=3D 0) {
        return false;
    }
   =20
    // Copy from the page into the output buffer
    memcpy(out_buffer, page-&gt;data + target_slot.offset, target_slot.leng=
th);
    return true;
}

// Deletes a tuple (tombstone method)
bool delete_tuple(Page *page, int slot_id) {
    PageHeader *header =3D (PageHeader *)page-&gt;data;
   =20
    if (slot_id &lt; 0 || slot_id &gt;=3D header-&gt;slot_count) {
        return false;
    }
   =20
    Slot *slots =3D (Slot *)(page-&gt;data + sizeof(PageHeader));
   =20
    // We don't shift data to defragment immediately.=20
    // We just set length to 0 to mark it as deleted.
    slots[slot_id].length =3D 0;
    slots[slot_id].offset =3D 0;
   =20
    return true;
}</code></pre></div>
